# ==========================================
# Cyber Kawach Environment Configuration Template
# ==========================================
# Copy this file to .env and configure your local credentials.
# NEVER commit your actual .env file to GitHub.

# Google Gemini API Key (Required for AI Threat Analysis)
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY="your_gemini_api_key_here"

# Application URL (Default for local development)
APP_URL="http://localhost:3000"

# Server Port (Default: 3000)
PORT=3000

# Optional: Firebase Client Configuration (if overriding firebase-applet-config.json)
# VITE_FIREBASE_API_KEY="your_firebase_web_api_key"
# VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
# VITE_FIREBASE_PROJECT_ID="your-project-id"
# VITE_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
# VITE_FIREBASE_MESSAGING_SENDER_ID="your_sender_id"
# VITE_FIREBASE_APP_ID="your_app_id"
# VITE_FIREBASE_DATABASE_ID="your_database_id"
